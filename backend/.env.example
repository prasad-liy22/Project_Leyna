# Copy this file to `.env` and fill in your values.

# Required: create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Base URL of the Ollama API.
#   Cloud: https://ollama.com
#   Local: http://localhost:11434
OLLAMA_BASE_URL=https://ollama.com

# Model to use. `gemma4:31b-cloud` is verified working against ollama.com;
# the name from `curl https://ollama.com/api/tags` (e.g. gemma4:31b) also works.
OLLAMA_MODEL=gemma4:31b-cloud

# Default assistant persona. Overridable per request via the `system` field.
# Leave this unset to use the built-in Nimna persona defined in app/prompts.py.
# SYSTEM_PROMPT=You are a helpful, concise assistant.

# Upstream request timeout, in seconds.
REQUEST_TIMEOUT=120

# --- Short-term memory -------------------------------------------------------
# Requests are stateless unless they send a `conversation_id`. When they do, the
# server keeps the transcript in memory and sends the model only the newest part
# of it. NOTE: the store is per-process, so run a single uvicorn worker.
MEMORY_ENABLED=true

# Approximate token budget for the transcript sent to the model. Older messages
# are dropped once it is exceeded. (Estimated with a character heuristic.)
MEMORY_TOKEN_BUDGET=3000

# Most messages kept per conversation.
MEMORY_MAX_MESSAGES=60

# Most conversations kept; the least recently used go first.
MEMORY_MAX_CONVERSATIONS=100

# Minutes of inactivity after which a conversation is forgotten.
MEMORY_TTL_MINUTES=180

# Also send the first user message when older messages are trimmed.
MEMORY_KEEP_FIRST=false

# Comma-separated list of origins allowed to call this API from a browser.
# Use '*' during development, or e.g. http://localhost:3000 in production.
CORS_ORIGINS=*

# Debug API (logs, token usage, runtime API key). Disable in production.
DEBUG_ENABLED=true

# When set, /debug routes require a matching X-Admin-Token header.
ADMIN_TOKEN=

# Folder served at '/' as the web UI. Defaults to <repo>/web/dist.
# WEB_DIR=

# --- Database (persistent memory) -------------------------------------------
# Set to 'db' to use persistent SQLAlchemy storage instead of in-memory.
# MEMORY_BACKEND=memory
# DATABASE_URL=sqlite:///./leyna_memory.db
# For Postgres: postgresql+psycopg2://user:pass@host:5432/dbname
