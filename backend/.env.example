# Copy this file to `.env` and fill in your values.

# Required: create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Base URL of the Ollama API.
#   Cloud: https://ollama.com
#   Local: http://localhost:11434
OLLAMA_BASE_URL=https://ollama.com

# Model to use. `gemma4:31b-cloud` is verified working against ollama.com;
# the name from `curl https://ollama.com/api/tags` (e.g. gemma4:31b) also works.
OLLAMA_MODEL=gemma4:31b-cloud

# Default assistant persona. Overridable per request via the `system` field.
SYSTEM_PROMPT=You are Leyna, a warm, concise and helpful personal assistant.

# Upstream request timeout, in seconds.
REQUEST_TIMEOUT=120

# Comma-separated list of origins allowed to call this API from a browser.
# Use '*' during development, or e.g. http://localhost:3000 in production.
CORS_ORIGINS=*
